{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnose public-shell session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "status", "current_step", "updated_at", "raw_question", "interactions", "pending_question", "awaiting_user", "handoff"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"type": "string", "minLength": 1},
    "status": {"enum": ["in_progress", "completed"]},
    "current_step": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "raw_question": {"type": "string", "minLength": 1},
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn", "judgment", "question", "response"],
        "properties": {
          "turn": {"type": "integer", "minimum": 1},
          "judgment": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "response": {"type": ["string", "null"]}
        }
      }
    },
    "pending_question": {"type": ["string", "null"]},
    "awaiting_user": {"type": "boolean"},
    "handoff": {"type": ["object", "null"]}
  }
}
