{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Methodology Plan",
  "type": "object",
  "required": [
    "schema_version",
    "skill",
    "project",
    "question",
    "mode",
    "frameworks",
    "stages",
    "gates"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "skill": {"type": "string", "enum": ["research"]},
    "project": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["live", "knowledge-based"]},
    "frameworks": {
      "type": "array",
      "minItems": 8,
      "items": {"type": "string"}
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "items": {"type": "string"}
    },
    "gates": {
      "type": "object",
      "required": ["stop_check", "claim_labels", "repair_loop_max"],
      "properties": {
        "stop_check": {"type": "boolean", "enum": [true]},
        "claim_labels": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "string"}
        },
        "repair_loop_max": {"type": "integer", "enum": [2]}
      }
    }
  }
}
