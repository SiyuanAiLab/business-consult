{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Falsify attempts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "generated_at", "preregistration_sha256", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "preregistration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_hash", "planned_query_count", "actual_query_count", "rounds_used", "attempts", "successful_open_count", "credible_counterevidence_count", "uncovered_scope", "stop_reason"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "planned_query_count": {"type": "integer", "minimum": 1},
          "actual_query_count": {"type": "integer", "minimum": 1},
          "rounds_used": {"type": "integer", "minimum": 1, "maximum": 2},
          "attempts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attempt_id", "round", "query", "attempted_at", "status", "opened_sources", "failure_reason"],
              "properties": {
                "attempt_id": {"type": "string", "minLength": 1},
                "round": {"type": "integer", "minimum": 1, "maximum": 2},
                "query": {"type": "string", "minLength": 1},
                "attempted_at": {"type": "string", "minLength": 1},
                "status": {"enum": ["completed", "failed"]},
                "opened_sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "title", "fetch_status", "source_kind", "relation", "final_evidence", "notes"],
                    "properties": {
                      "url": {"type": "string", "pattern": "^https?://"},
                      "title": {"type": "string"},
                      "fetch_status": {"enum": ["opened", "failed"]},
                      "source_kind": {"enum": ["primary", "authoritative-secondary", "other"]},
                      "relation": {"enum": ["contradicts", "supports", "context", "no-relevance"]},
                      "final_evidence": {"type": "boolean"},
                      "notes": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "failure_reason": {"type": "string"}
              }
            }
          },
          "successful_open_count": {"type": "integer", "minimum": 0},
          "credible_counterevidence_count": {"type": "integer", "minimum": 0},
          "uncovered_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "stop_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
